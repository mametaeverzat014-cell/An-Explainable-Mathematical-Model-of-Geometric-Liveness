# ---- Сырые биометрические данные НИКОГДА не коммитятся ----
data/raw/**
!data/raw/.gitkeep

# ---- Производные биометрические данные тоже не коммитятся ----
# Покадровые координаты точек лица и извлечённые кадры с лицами — это
# персональные данные участников, публиковать их нельзя.
results/landmarks/
results/attack_photos/

# Единственный график, на котором видно лицо участника.
figures/landmark_example.png

# ---- Агрегированные результаты КОММИТЯТСЯ ----
# results/*.csv и остальные figures/*.png содержат только псевдонимы, числа и
# графики без лиц. Именно они составляют воспроизводимый отчёт о результатах,
# поэтому хранятся в репозитории: любую метрику из работы можно проверить.
#
# Если вы решите не публиковать даже огрублённые пропорции лица из
# video_features.csv, допишите сюда строку: results/video_features.csv

# Собираемые файлы научной работы (пересобираются одной командой)
# report.pdf НАМЕРЕННО коммитится: это главный документ работы, и жюри должно
# открывать его прямо из репозитория, не собирая проект у себя.
report.html
fonts.css
fonts/

