{
  "name": "parallax-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Open, explainable research instrument for testing whether a presented face is consistent with a planar surface.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "dev": "npm run fetch-assets && vite",
    "build": "npm run fetch-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:method": "vitest run --config vitest.method.config.ts",
    "test:e2e": "playwright test",
    "make-synthetic": "tsx scripts/make-synthetic-recordings.ts",
    "analyze": "tsx scripts/analyze-recordings.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
